{
  "name": "medical-eligibility-verification",
  "description": "A Midnight dApp for Medical Eligibility Verification using Confidential Credentials (ZK proofs)",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "boilerplate/contract",
    "boilerplate/contract-cli",
    "boilerplate/scripts",
    "boilerplate/frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w boilerplate/frontend",
    "postinstall": "node patch-runtime.mjs",
    "compile": "COMPACT_CMD=\"compact compile +0.31.1\"; if command -v compactc >/dev/null 2>&1 && compactc --version >/dev/null 2>&1; then COMPACT_CMD=\"compactc\"; fi; cd boilerplate/contract/src && rm -rf managed/medical-eligibility-verification && mkdir -p managed/medical-eligibility-verification && $COMPACT_CMD medical-eligibility-verification.compact managed/medical-eligibility-verification && sed -i 's/.*checkRuntimeVersion.*//g' managed/medical-eligibility-verification/contract/index.js && echo '✅ Contract compiled' && cd ../../.. && npm run build -w boilerplate/contract",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "cli": "npm run cli -w boilerplate/contract-cli",
    "wallet": "node boilerplate/scripts/generate-key.js",
    "faucet": "node boilerplate/scripts/request-faucet.js",
    "balance": "node boilerplate/scripts/check-balance.js",
    "deploy": "node boilerplate/scripts/deploy.js --new",
    "deploy:new": "node boilerplate/scripts/deploy.js --new",
    "deploy:join": "node boilerplate/scripts/deploy.js --join",
    "check": "node -e \"console.log('✅ Medical Eligibility Verification dApp ready!'); console.log('💡 Run: npm run compile && npm run cli'); process.exit(0)\""
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.29",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "testcontainers": "^11.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "^0.8.1",
    "@midnight-ntwrk/ledger": "^4.0.0",
    "@midnight-ntwrk/midnight-js-contracts": "2.0.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "2.0.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "2.0.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "2.0.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "2.0.1",
    "@midnight-ntwrk/midnight-js-types": "2.0.1",
    "@midnight-ntwrk/wallet": "5.0.0",
    "@midnight-ntwrk/wallet-api": "5.0.0",
    "@midnight-ntwrk/zswap": "^4.0.0",
    "dotenv": "^16.5.0",
    "node-fetch": "^3.3.2",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "ws": "^8.18.2"
  },
  "overrides": {
    "vite": "^8.0.0"
  }
}
